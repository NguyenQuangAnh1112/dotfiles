  _ _ _ _
  _ _ _ _ _ _
  _ _ _ _ _
)

(deflayer nav
  _ _ _ _ _
  end caps del ret f11
  esc home _ _
  left down up rght _ _
  mlft mrgt S-tab tab _
)
