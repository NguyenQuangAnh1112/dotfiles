(defcfg
  process-unmapped-keys yes
  concurrent-tap-hold yes
  log-layer-changes no
  linux-continue-if-no-devs-found yes
  linux-dev-names-exclude (
    "Lotus-Uinput-Server"
  )
)

(defalias
  nav  (layer-while-held nav)
  ;; Chạm nhẹ Caps = Esc, giữ Caps = Left Ctrl
  ecl  (tap-hold-press 200 200 A-spc lctl)
  
  ;; Cuộn chuột dọc & ngang
  mwu  (mwheel-up 80 120)
  mwd  (mwheel-down 80 120)
  
  ;; Điều hướng nâng cao (nhảy từ, xóa từ)
  cl C-left
  cr C-rght
  cbk C-bspc
)

(defsrc
  esc  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]
  caps a    s    d    f    g    h    j    k    l    ;    '    ret
  z    x    c    v    b    n    m    ,    .    /
  lctl lalt spc  ralt
)

(deflayer base
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _
  @ecl _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _
  @nav _    _    _
)

(deflayer nav
  lrld f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12  _
  _    _    _    ret  _    _    _    esc  home _    bspc @cbk _
  _    end  _    del  f11  _    left down up   rght  ret  _   _
  _    _    caps _    _    _    @cl  @mwu @mwd @cr
  _    _    A-grv _
)
