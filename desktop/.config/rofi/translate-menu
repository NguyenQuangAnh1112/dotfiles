#!/usr/bin/env python3
import os
import sys
import json
import urllib.parse
import urllib.request
import urllib.error
import subprocess

CACHE_DIR = os.path.expanduser("~/.cache")
HISTORY_FILE = os.path.join(CACHE_DIR, "rofi-translate-history.txt")
ROFI_THEME = os.path.expanduser("~/.config/rofi/translate.rasi")
MAX_HISTORY = 25
CLEAR_LABEL = "🗑 Clear translation history"


def translate_text(text: str) -> tuple[str, str, str]:
    """
    Translates text using Google Translate web endpoint.
    Auto-detects source language:
      - If source is Vietnamese ('vi') -> translates to English ('en')
      - If source is any other language -> translates to Vietnamese ('vi')
    Returns: (translated_text, source_lang, target_lang)
    """
    clean_text = text.strip()
    if not clean_text:
        return "", "", ""

    # First attempt with auto target
    url = (
        "https://translate.googleapis.com/translate_a/single?client=gtx&sl=auto&tl=vi&dt=t&q="
        + urllib.parse.quote(clean_text)
    )
    req = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0"})
    with urllib.request.urlopen(req, timeout=6) as res:
        data = json.loads(res.read().decode("utf-8"))
        detected = data[2] if len(data) > 2 else "auto"

    if detected == "vi":
        target = "en"
        url = (
            "https://translate.googleapis.com/translate_a/single?client=gtx&sl=vi&tl=en&dt=t&q="
            + urllib.parse.quote(clean_text)
        )
        req = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0"})
        with urllib.request.urlopen(req, timeout=6) as res:
            data = json.loads(res.read().decode("utf-8"))
    else:
        target = "vi"

    translated = "".join([item[0] for item in data[0] if item and item[0]])
    return translated, detected, target


def get_selection() -> str:
    """Fetch text currently highlighted on screen via Wayland primary selection."""
    try:
        proc = subprocess.run(
            ["wl-paste", "--primary"],
            capture_output=True,
            text=True,
            timeout=1,
            check=False,
        )
        res = proc.stdout.strip()
        if res and len(res) <= 1000:
            return res
    except Exception:
        pass
    return ""


def load_history() -> list[str]:
    if not os.path.isfile(HISTORY_FILE):
        return []
    with open(HISTORY_FILE, "r", encoding="utf-8") as f:
        return [line.strip() for line in f if line.strip()]


def save_history(history: list[str]):
    os.makedirs(CACHE_DIR, exist_ok=True)
    with open(HISTORY_FILE, "w", encoding="utf-8") as f:
        for item in history[:MAX_HISTORY]:
            f.write(f"{item}\n")


def copy_and_notify(original: str, translated: str, src_lang: str, tgt_lang: str):
    subprocess.run(["wl-copy", translated], check=False)
    summary = f"🌐 Translate ({src_lang} → {tgt_lang})"
    # Limit body display length for notification aesthetics
    orig_display = original if len(original) <= 80 else original[:77] + "..."
    body = f"{orig_display}\n\n👉 {translated}\n(Đã sao chép vào clipboard)"
    subprocess.run(
        ["notify-send", "-i", "accessories-dictionary", summary, body],
        check=False,
    )


def handle_translation(text: str, history: list[str] = None):
    try:
        translated, src_lang, tgt_lang = translate_text(text)
        if not translated:
            return

        if history is not None:
            # Format: "TRANSLATED   (← ORIGINAL)"
            entry = f"{translated}   (← {text})"
            if entry in history:
                history.remove(entry)
            history.insert(0, entry)
            save_history(history)

        copy_and_notify(text, translated, src_lang, tgt_lang)
    except urllib.error.URLError:
        subprocess.run(
            [
                "notify-send",
                "-u",
                "low",
                "-i",
                "dialog-error",
                "Translator",
                "Không thể kết nối đến máy chủ dịch (kiểm tra mạng)",
            ],
            check=False,
        )
    except Exception as e:
        subprocess.run(
            [
                "notify-send",
                "-u",
                "low",
                "-i",
                "dialog-error",
                "Translator",
                f"Lỗi khi dịch: {e}",
            ],
            check=False,
        )


def main():
    # Instant mode: Translate highlighted text directly without UI popup
    if len(sys.argv) > 1 and sys.argv[1] == "--instant":
        selection = get_selection()
        if not selection:
            subprocess.run(
                ["notify-send", "-u", "low", "Translator", "Chưa bôi đen văn bản nào để dịch!"],
                check=False,
            )
            sys.exit(0)
        history = load_history()
        handle_translation(selection, history)
        sys.exit(0)

    # Interactive UI mode
    history = load_history()
    selection = get_selection()

    menu_entries = []
    selection_prompt_prefix = "👉 Dịch đoạn bôi đen: "
    if selection:
        # One-line preview of selection
        preview = selection.replace("\n", " ")
        if len(preview) > 50:
            preview = preview[:47] + "..."
        menu_entries.append(f"{selection_prompt_prefix}{preview}")

    menu_entries.extend(history)
    if menu_entries:
        menu_entries.append(CLEAR_LABEL)

    input_text = "\n".join(menu_entries)
    rofi_cmd = [
        "rofi",
        "-config",
        ROFI_THEME,
        "-dmenu",
        "-p",
        "🌐 Translate",
    ]

    proc = subprocess.run(
        rofi_cmd,
        input=input_text,
        text=True,
        capture_output=True,
    )

    if proc.returncode != 0:
        sys.exit(0)

    choice = proc.stdout.strip()
    if not choice:
        sys.exit(0)

    # 1. Clear history chosen
    if choice == CLEAR_LABEL:
        if os.path.isfile(HISTORY_FILE):
            os.remove(HISTORY_FILE)
        subprocess.run(
            ["notify-send", "-i", "accessories-dictionary", "Translator", "Đã xóa lịch sử dịch thuật"],
            check=False,
        )
        sys.exit(0)

    # 2. Chosen "Dịch đoạn bôi đen"
    if choice.startswith(selection_prompt_prefix):
        handle_translation(selection, history)
        sys.exit(0)

    # 3. Selected an existing history entry: "TRANSLATED   (← ORIGINAL)"
    if "   (← " in choice:
        translated_part = choice.split("   (← ")[0].strip()
        orig_part = choice.split("   (← ")[1].rstrip(")")
        subprocess.run(["wl-copy", translated_part], check=False)
        subprocess.run(
            [
                "notify-send",
                "-i",
                "accessories-dictionary",
                "Translator",
                f"Đã sao chép: {translated_part}",
            ],
            check=False,
        )
        sys.exit(0)

    # 4. Typed a new expression
    handle_translation(choice, history)


if __name__ == "__main__":
    main()
