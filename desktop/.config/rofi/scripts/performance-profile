#!/usr/bin/env python3

import subprocess
import os
import shutil

performance_icon = "󱓞"
balanced_icon = "󰓅"
quiet_icon = "󰁻"

yes_icon = ""
no_icon = ""

config_dir = os.environ.get("XDG_CONFIG_HOME", "") + "/rofi"
asusctl_bin = shutil.which("asusctl")


def get_current_profile() -> str:
    if not asusctl_bin:
        return "Unavailable"

    try:
        result = subprocess.run(
            [
                asusctl_bin,
                "profile",
                "-p",
            ],
            capture_output=True,
            text=True,
            check=False,
        )
        lines = result.stdout.splitlines()
        if len(lines) > 1:
            return lines[1].split()[-1]
    except FileNotFoundError:
        pass

    return "Unknown"


def performance_profile_menu() -> None:
    opts = [
        ["Performance", performance_icon],
        ["Balanced", balanced_icon],
        ["Quiet", quiet_icon],
    ]

    if not asusctl_bin:
        print("\0prompt\x1fProfile")
        print("\0message\x1fasusctl is missing. Install asusctl to enable this mode.")
        print(f"{no_icon} asusctl missing{chr(0)}nonselectable\x1ftrue")
        return

    current_profile = get_current_profile()
    print("\0prompt\x1fProfile")
    print(f"\0message\x1fCurrent Profile: {current_profile}")

    for mode, icon in opts:
        print(f"{icon} {mode}{chr(0)}info\x1f{mode.lower()}")


def set_performance_profile(profile: str) -> None:
    if not asusctl_bin:
        subprocess.run(
            [
                "notify-send",
                "⚡ Performance Mode",
                "asusctl is not installed",
                "--expire-time=2500",
                "-u",
                "normal",
            ],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        )
        return

    subprocess.run(
        [asusctl_bin, "profile", "-P", profile],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )

    subprocess.run(
        [
            "notify-send",
            "⚡ Performance Mode",
            f"Set to: {profile.capitalize()}",
            "--expire-time=2000",
            "-u",
            "normal",
        ],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )


if __name__ == "__main__":
    selection = os.environ.get("ROFI_INFO")

    if selection:
        set_performance_profile(selection)
    else:
        performance_profile_menu()
