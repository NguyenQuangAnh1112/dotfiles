set $mod Mod4
set $term kitty
set $menu rofi -show drun-smart -modi "drun-smart:/home/muggle/.config/i3/rofi-drun-smart" -show-icons true -matching fuzzy -no-sort
set $x11 env XDG_SESSION_TYPE=x11 XCURSOR_THEME=Bibata-Modern-Ice XCURSOR_SIZE=32

font pango:monospace 10

default_border none
default_floating_border none
smart_borders on
hide_edge_borders smart
floating_modifier $mod
focus_on_window_activation smart

# Environment
exec_always --no-startup-id dbus-update-activation-environment --systemd DISPLAY XAUTHORITY XDG_SESSION_TYPE=x11 XDG_CURRENT_DESKTOP=i3 DESKTOP_SESSION=i3 XDG_SESSION_DESKTOP=i3
exec_always --no-startup-id ~/.config/i3/touchpad.sh
exec_always --no-startup-id sh -c 'pkill -f "$HOME/.config/i3/fast-wheel.py" 2>/dev/null || true; WHEEL_SCROLL_MULTIPLIER=2 "$HOME/.config/i3/fast-wheel.py" >/tmp/fast-wheel.log 2>&1 &'
exec_always --no-startup-id sh -c 'command -v xset >/dev/null 2>&1 && xset s off -dpms s noblank'
exec_always --no-startup-id sh -c 'pgrep -u "$USER" -x picom >/dev/null 2>&1 || { command -v picom >/dev/null 2>&1 && picom --config "$HOME/.config/picom/picom.conf" --use-damage -b; }'
exec_always --no-startup-id sh -c 'command -v xrdb >/dev/null 2>&1 && xrdb -merge "$HOME/.Xresources"'
exec --no-startup-id sh -c 'command -v dunst >/dev/null 2>&1 && dunst'
exec --no-startup-id sh -c 'command -v fcitx5 >/dev/null 2>&1 && fcitx5 -d'
exec --no-startup-id sh -c 'command -v copyq >/dev/null 2>&1 && copyq'
exec --no-startup-id ~/.config/i3/start-polkit-agent.sh
exec_always --no-startup-id sh -c '~/.config/i3/monitor-layout.sh; sleep 0.3; ~/.config/i3/wallpaper-select.sh --restore'

# Apps
bindsym $mod+Return exec --no-startup-id $x11 GLFW_IM_MODULE=ibus $term
bindsym $mod+Shift+Return exec --no-startup-id $x11 ghostty
bindsym $mod+d exec --no-startup-id $x11 $menu
bindsym Mod1+space exec --no-startup-id $x11 $menu
bindsym Mod1+r exec --no-startup-id $x11 rofi -show run
bindcode --release Mod1+Shift+65 exec --no-startup-id $x11 rofi -modes run -show run -display-run "GPU" -run-command "env DRI_PRIME=1 {cmd}"
bindsym $mod+e exec --no-startup-id $x11 thunar
bindsym $mod+f exec --no-startup-id $x11 firefox
bindsym $mod+u exec --no-startup-id ~/.config/i3/unity-launch.sh
bindsym $mod+Shift+s exec --no-startup-id $x11 flameshot gui -c
bindsym $mod+n exec --no-startup-id $x11 nm-connection-editor
bindsym $mod+Shift+n exec --no-startup-id $x11 nm-connection-editor
bindsym $mod+v exec --no-startup-id $x11 copyq show
bindsym $mod+w exec --no-startup-id $x11 ~/.config/i3/wallpaper-select.sh
bindsym $mod+q kill

# Focus
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right
bindsym $mod+Tab focus output right
bindsym $mod+Shift+Tab focus output left

# Move windows
bindsym $mod+Shift+h move container to output left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move container to output right
bindsym $mod+Shift+Left move container to output left
bindsym $mod+Shift+Right move container to output right
bindsym $mod+Shift+Up move container to output up
bindsym $mod+Shift+Down move container to output down

# Layout
bindsym $mod+backslash layout toggle split, border none
bindsym $mod+m layout tabbed, border none
bindsym $mod+minus layout stacking, border none
bindsym $mod+Shift+f fullscreen toggle
bindsym $mod+Shift+space floating toggle

# Resize
mode "resize" {
    bindsym h resize shrink width 10 px or 10 ppt
    bindsym j resize grow height 10 px or 10 ppt
    bindsym k resize shrink height 10 px or 10 ppt
    bindsym l resize grow width 10 px or 10 ppt
    bindsym Left resize shrink width 10 px or 10 ppt
    bindsym Down resize grow height 10 px or 10 ppt
    bindsym Up resize shrink height 10 px or 10 ppt
    bindsym Right resize grow width 10 px or 10 ppt
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

# Workspaces
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

workspace $ws1 output eDP-1
workspace $ws2 output eDP-1
workspace $ws3 output eDP-1
workspace $ws4 output eDP-1
workspace $ws5 output eDP-1
workspace $ws6 output eDP-1
workspace $ws7 output eDP-1
workspace $ws8 output eDP-1
workspace $ws9 output eDP-1
workspace $ws10 output primary eDP-1

bindsym $mod+1 focus output eDP-1; workspace number $ws1
bindsym $mod+2 focus output eDP-1; workspace number $ws2
bindsym $mod+3 focus output eDP-1; workspace number $ws3
bindsym $mod+4 focus output eDP-1; workspace number $ws4
bindsym $mod+5 focus output eDP-1; workspace number $ws5
bindsym $mod+6 focus output eDP-1; workspace number $ws6
bindsym $mod+7 focus output eDP-1; workspace number $ws7
bindsym $mod+8 focus output eDP-1; workspace number $ws8
bindsym $mod+9 focus output eDP-1; workspace number $ws9
bindsym $mod+0 workspace number $ws10

bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

bindsym $mod+Control+Right workspace next_on_output
bindsym $mod+Control+Left workspace prev_on_output
bindsym $mod+Control+h move workspace to output left
bindsym $mod+Control+l move workspace to output right
bindsym $mod+space exec --no-startup-id ~/.config/i3/swap-panes.sh

# Unity
assign [class="^(unityhub|UnityHub)$"] $ws10
assign [class="^(Unity|UnityEditor|unity-editor)$"] $ws10
for_window [class="^(Unity|UnityEditor|unity-editor)$" window_type="dialog"] floating enable, border normal, move position center, focus
for_window [class="^(Unity|UnityEditor|unity-editor)$" window_type="utility"] floating enable, border normal, move position center, focus
for_window [class="^(Unity|UnityEditor|unity-editor)$" window_type="toolbar"] floating enable, border normal, move position center, focus
for_window [class="^(Unity|UnityEditor|unity-editor)$" window_role="pop-up"] floating enable, border normal, move position center, focus

# Media
bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +5%
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -5%
bindsym XF86AudioMute exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle
bindsym XF86AudioMicMute exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle
bindsym XF86AudioPlay exec --no-startup-id sh -c 'command -v playerctl >/dev/null 2>&1 && playerctl play-pause'
bindsym XF86AudioNext exec --no-startup-id sh -c 'command -v playerctl >/dev/null 2>&1 && playerctl next'
bindsym XF86AudioPrev exec --no-startup-id sh -c 'command -v playerctl >/dev/null 2>&1 && playerctl previous'
bindsym XF86MonBrightnessUp exec --no-startup-id brightnessctl set +10%
bindsym XF86MonBrightnessDown exec --no-startup-id brightnessctl set 10%-
bindsym $mod+Up exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +5%
bindsym $mod+Down exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -5%
bindsym $mod+Right exec --no-startup-id brightnessctl set +10%
bindsym $mod+Left exec --no-startup-id brightnessctl set 10%-

# Session
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart
bindsym $mod+Shift+e exec --no-startup-id i3-msg exit
bindsym $mod+Shift+x exec --no-startup-id i3lock -c 000000
bindsym $mod+Shift+z exec --no-startup-id sh -c 'i3lock -c 000000; systemctl suspend'
bindsym Control+Mod1+$mod+b bar mode toggle

bar {
    output eDP-1
    status_command i3status
    tray_output primary
}
