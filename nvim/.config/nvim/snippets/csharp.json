      "{",
      "    ${2}",
      "}"
    ]
  },
  "Unity Trigger Enter": {
    "prefix": "ote",
    "description": "OnTriggerEnter callback",
    "body": [
      "private void OnTriggerEnter(Collider other)",
      "{",
