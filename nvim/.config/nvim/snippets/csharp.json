{
  "Unity SerializeField": {
    "prefix": "ser",
    "description": "Serialized private field",
    "body": [
      "[SerializeField] private ${1:float} ${2:fieldName};"
    ]
  },
  "Unity GetComponent In Awake": {
    "prefix": "gc",
    "description": "Cache a component in Awake",
    "body": [
      "private ${1:Rigidbody} ${2:rb};",
      "",
      "private void Awake()",
      "{",
      "    ${2:rb} = GetComponent<${1:Rigidbody}>();",
      "}"
    ]
  },
  "Unity Input Key Block": {
    "prefix": "key",
    "description": "Input.GetKeyDown block",
    "body": [
