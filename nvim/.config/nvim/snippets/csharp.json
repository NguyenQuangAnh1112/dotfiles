    ]
  },
  "Unity Singleton": {
    "prefix": "sg",
    "description": "Simple MonoBehaviour singleton",
    "body": [
      "public static ${1:${TM_FILENAME_BASE}} Instance { get; private set; }",
      "",
      "private void Awake()",
      "{",
      "    if (Instance != null && Instance != this)",
      "    {",
      "        Destroy(gameObject);",
      "        return;",
      "    }",
      "",
      "    Instance = this;",
      "    ${2:DontDestroyOnLoad(gameObject);}",
      "}"
    ]
  }
