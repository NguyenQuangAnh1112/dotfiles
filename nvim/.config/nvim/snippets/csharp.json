  "CSharp EventHandler Event": {
    "prefix": "evt",
    "description": "C# EventHandler event declaration",
    "body": [
      "public event System.EventHandler ${1:OnSomething};"
    ]
  },
  "CSharp EventHandler Event Args": {
    "prefix": "evtargs",
    "description": "C# EventHandler<TEventArgs> event with matching EventArgs class",
    "body": [
      "public event System.EventHandler<${1:OnSelectedCounterChanged}EventArgs> ${1:OnSelectedCounterChanged};",
      "",
      "public class ${1:OnSelectedCounterChanged}EventArgs : System.EventArgs",
      "{",
      "    public ${2:BaseCounter} ${3:selectedCounter};",
      "}"
    ]
