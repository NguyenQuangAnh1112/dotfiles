    ]
  },
  "Unity Header Field": {
    "prefix": "hdr",
    "description": "Header attribute with serialized field",
    "body": [
      "[Header(\"${1:Settings}\")]",
      "[SerializeField] private ${2:float} ${3:fieldName} = ${4:defaultValue};"
    ]
  },
  "Unity Range Field": {
    "prefix": "rng",
    "description": "Range attribute with serialized float",
    "body": [
